{
  "name": "@rwa/web",
  "version": "1.0.0",
  "private": true,
  "description": "React + Vite frontend of the payment app.",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "start:host": "vite --host",
    "build": "vite build",
    "build:ci": "vite build",
    "types": "tsc --noEmit -p tsconfig.node.json",
    "types:full": "tsc --noEmit -p tsconfig.json",
    "serve:build": "ts-node -P tsconfig.tsnode.json scripts/testServer.ts",
    "copy:mock:awsexports": "ncp scripts/mock-aws-exports.js src/aws-exports.js",
    "copy:mock:awsexportses5": "ncp scripts/mock-aws-exports-es5.js aws-exports-es5.js",
    "predev:cognito:ci": "pnpm copy:mock:awsexports && pnpm copy:mock:awsexportses5",
    "build:aws-exports-es5": "cross-env tsc --skipLibCheck --allowJs --lib 'es5' --module 'commonjs' --target 'es5' --moduleResolution 'node' --outDir . src/aws-exports.js; mv aws-exports.js aws-exports-es5.js",
    "testid:list": "ts-node -P tsconfig.tsnode.json scripts/generateTestIdList.ts",
    "testid:check": "ts-node -P tsconfig.tsnode.json scripts/generateTestIdList.ts --check",
    "testid:add": "ts-node -P tsconfig.tsnode.json scripts/generateTestIdList.ts --add",
    "testid:add:write": "ts-node -P tsconfig.tsnode.json scripts/generateTestIdList.ts --add --write",
    "postinstall": "patch-package"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "2.2.4",
    "@babel/core": "^7.28.0",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.14.9",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@matheusluizn/react-google-login": "^5.1.6",
    "@mui/icons-material": "^5.15.12",
    "@mui/lab": "^5.0.0-alpha.167",
    "@mui/material": "^5.15.12",
    "@okta/okta-auth-js": "^7.3.0",
    "@okta/okta-react": "^6.7.0",
    "@rwa/shared": "workspace:*",
    "@xstate/react": "3.2.2",
    "aws-amplify": "^6.0.16",
    "axios": "0.28.1",
    "clsx": "1.2.1",
    "date-fns": "4.1.0",
    "formik": "2.4.6",
    "graphql-tag": "2.12.6",
    "history": "4.10.1",
    "lodash": "4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-number-format": "4.9.4",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-virtualized": "9.22.5",
    "webpack": "5",
    "xstate": "4.38.3",
    "yup": "0.32.11"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/preset-env": "^7.28.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bluebird": "3.5.36",
    "@types/connect-flash": "0.0.37",
    "@types/connect-history-api-fallback": "1.3.5",
    "@types/express": "4.17.21",
    "@types/http-proxy-middleware": "0.19.3",
    "@types/json-server": "0.14.4",
    "@types/jwt-decode": "2.2.1",
    "@types/lodash": "4.14.181",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/react-router": "5.1.18",
    "@types/react-router-dom": "5.3.3",
    "@types/react-virtualized": "9.21.21",
    "@types/serve-static": "1.15.7",
    "@types/webpack-env": "1.16.4",
    "@types/yup": "0.29.13",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-loader": "^10.0.0",
    "connect-history-api-fallback": "1.6.0",
    "dotenv": "16.0.0",
    "eslint": "^10.0.2",
    "express": "4.20.0",
    "graphql-tools": "8.2.7",
    "http-proxy-middleware": "0.19.1",
    "jsdom": "^22.1.0",
    "ncp": "2.0.0",
    "patch-package": "^7.0.0",
    "prettier": "^3.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vite": "^8.2.2",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.2.4"
  }
}
