generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // public: the app tables. testschema: test runs, shared fixtures and results (the app reset does not touch it)
  schemas  = ["public", "testschema"]
}

// "contacts" is a leftover: there is no friends list any more, so it behaves like "private"
enum PrivacyLevel {
  public
  private
  contacts

  @@schema("public")
}

enum TransactionStatus {
  pending
  incomplete
  complete

  @@schema("public")
}

enum BankTransferType {
  withdrawal
  deposit

  @@schema("public")
}

// requested -> completed | failed | canceled
enum BankTransferStatus {
  requested
  completed
  failed
  canceled

  @@schema("public")
}

model User {
  id                  String        @id
  uuid                String        @unique
  firstName           String
  lastName            String
  username            String        @unique
  password            String
  email               String?
  phoneNumber         String?
  avatar              String?
  defaultPrivacyLevel PrivacyLevel?
  balance             Int
  createdAt           DateTime
  modifiedAt          DateTime

  @@map("users")
  @@schema("public")
}

model BankAccount {
  id            String   @id
  uuid          String   @unique
  userId        String
  bankName      String
  accountNumber String
  visible       Boolean
  balance       Int      @default(0) // cents, money held in this bank account
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("bank_accounts")
  @@schema("public")
}

model Transaction {
  id                  String            @id
  uuid                String            @unique
  source              String
  amount              Int
  description         String
  privacyLevel        PrivacyLevel
  receiverId          String
  senderId            String
  balanceAtCompletion Int?
  status              TransactionStatus
  // Money goes from the payer's bank account to the payee's bank account.
  // payer = sender, payee = receiver.
  payerAccountId      String?
  payeeAccountId      String?
  payerBalanceAfter   Int? // payer's bank account balance right after the money moved (cents)
  payeeBalanceAfter   Int? // payee's bank account balance right after the money moved (cents)
  createdAt           DateTime
  modifiedAt          DateTime

  @@index([senderId])
  @@index([receiverId])
  @@map("transactions")
  @@schema("public")
}

model Like {
  id            String   @id
  uuid          String   @unique
  userId        String
  transactionId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([transactionId])
  @@map("likes")
  @@schema("public")
}

model Comment {
  id            String   @id
  uuid          String   @unique
  content       String
  userId        String
  transactionId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([transactionId])
  @@map("comments")
  @@schema("public")
}

// payment / like / comment notifications share one table
model Notification {
  id            String   @id
  uuid          String   @unique
  userId        String
  transactionId String
  isRead        Boolean
  status        String? // payment notifications
  likeId        String? // like notifications
  commentId     String? // comment notifications
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("notifications")
  @@schema("public")
}

// Virtual deposit / withdrawal: no real money moves, only balances and records change.
model BankTransfer {
  id            String             @id
  uuid          String             @unique
  userId        String
  source        String // bank account id
  amount        Int // cents, always positive
  type          BankTransferType
  status        BankTransferStatus @default(requested)
  transactionId String? // only when the transfer is linked to a payment transaction
  balanceBefore Int? // user balance when the transfer completed
  balanceAfter  Int?
  createdAt     DateTime
  modifiedAt    DateTime

  logs BankTransferLog[]

  @@index([userId])
  @@index([source])
  @@map("bank_transfers")
  @@schema("public")
}

// Append-only history: one row per status change. Never updated, never deleted.
model BankTransferLog {
  id             String              @id
  bankTransferId String
  userId         String
  bankAccountId  String
  amount         Int
  fromStatus     BankTransferStatus? // null for the first row (creation)
  toStatus       BankTransferStatus
  balanceBefore  Int?
  balanceAfter   Int?
  note           String?
  createdAt      DateTime            @default(now())

  bankTransfer BankTransfer @relation(fields: [bankTransferId], references: [id], onDelete: Restrict)

  @@index([bankTransferId])
  @@index([userId, createdAt])
  @@map("bank_transfer_logs")
  @@schema("public")
}

// ===== testschema: test runs shared by the Web (Playwright) and the App (Flutter) =====
// One run number line for both platforms. A platform joins the newest number if it has not run it yet,
// otherwise the server opens newest+1 with new fixtures. Older numbers are closed.

// open: in use or can be joined. blocked: a platform stopped midway; kept but left out of statistics
enum TestRunStatus {
  open
  blocked

  @@schema("testschema")
}

enum TestPlatform {
  web
  app

  @@schema("testschema")
}

// waiting: another platform runs this number now. blocked: stopped midway (or no signal for 10 minutes)
enum PlatformRunStatus {
  waiting
  running
  finished
  blocked

  @@schema("testschema")
}

// spec: a test file. common: screen actions (tests/e2e/common). api: API tools (tests/e2e/api).
// fixture: the code that makes or reads the values that tests use (tests/e2e/fixture)
enum CodeKind {
  spec
  common
  api
  fixture

  @@schema("testschema")
}

enum CodeResultStatus {
  passed
  failed
  skipped

  @@schema("testschema")
}

// One row per run number
model TestRun {
  runNo     Int           @id @default(autoincrement()) @map("run_no")
  status    TestRunStatus @default(open)
  openedBy  TestPlatform  @map("opened_by")
  createdAt DateTime      @default(now()) @map("created_at")

  fixtures     TestFixture[]
  platformRuns PlatformRun[]
  results      CodeResult[]

  @@map("test_run")
  @@schema("testschema")
}

// Random values of a run number, one row per (test label, item). Web and App read the same values.
// Items are rows, not columns: a new test adds items without a DB change.
model TestFixture {
  runNo     Int      @map("run_no")
  testCase  String   @map("test_case") // the test's label, e.g. "deposit"
  item      String // e.g. "amount"
  value     String // stored as text; numbers are converted when read
  createdAt DateTime @default(now()) @map("created_at")

  run TestRun @relation(fields: [runNo], references: [runNo], onDelete: Restrict)

  @@id([runNo, testCase, item])
  @@map("test_fixture")
  @@schema("testschema")
}

// Did the Web / the App run this number. One row per (number, platform).
model PlatformRun {
  id           Int               @id @default(autoincrement())
  runNo        Int               @map("run_no")
  platform     TestPlatform
  status       PlatformRunStatus @default(running)
  device       String? // e.g. "chrome", an Android device name
  startedAt    DateTime          @default(now()) @map("started_at")
  lastSignalAt DateTime          @default(now()) @map("last_signal_at") // used by the 10-minute rule
  finishedAt   DateTime?         @map("finished_at")

  run     TestRun      @relation(fields: [runNo], references: [runNo], onDelete: Restrict)
  results CodeResult[]

  @@unique([runNo, platform])
  @@map("platform_run")
  @@schema("testschema")
}

// Result of one piece of test code: a spec, or a common / api / util function called inside a spec
model CodeResult {
  id            Int              @id @default(autoincrement())
  runNo         Int              @map("run_no")
  platformRunId Int              @map("platform_run_id")
  kind          CodeKind
  testCase      String           @map("test_case") // the test's label
  name          String // test title or function name, e.g. "createBankAccount"
  file          String
  parentId      Int?             @map("parent_id") // the spec result that called this code; empty for a spec
  status        CodeResultStatus
  attempt       Int              @default(1) // retry number
  errorMessage  String?          @map("error_message")
  startedAt     DateTime         @map("started_at")
  durationMs    Int              @map("duration_ms")

  run         TestRun      @relation(fields: [runNo], references: [runNo], onDelete: Restrict)
  platformRun PlatformRun  @relation(fields: [platformRunId], references: [id], onDelete: Restrict)
  parent      CodeResult?  @relation("CalledFrom", fields: [parentId], references: [id], onDelete: Restrict)
  children    CodeResult[] @relation("CalledFrom")

  @@index([runNo, kind])
  @@index([testCase])
  @@map("code_result")
  @@schema("testschema")
}
