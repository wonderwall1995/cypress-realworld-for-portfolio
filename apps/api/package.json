{
  "name": "@rwa/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma (PostgreSQL) API server of the payment app.",
  "license": "MIT",
  "scripts": {
    "start": "ts-node --files src/app.ts",
    "start:watch": "nodemon --exec ts-node --files --watch src src/app.ts",
    "start:watch:poll": "nodemon -L --exec ts-node --files --watch src src/app.ts",
    "types": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "prisma:cli": "dotenv -e ../../.env -- prisma",
    "prisma:generate": "pnpm prisma:cli generate",
    "prisma:migrate": "pnpm prisma:cli migrate dev"
  },
  "dependencies": {
    "@graphql-tools/graphql-file-loader": "7.5.17",
    "@graphql-tools/load": "7.8.14",
    "@graphql-tools/schema": "8.3.9",
    "@okta/jwt-verifier": "^3.0.1",
    "@prisma/client": "6",
    "@rwa/shared": "workspace:*",
    "bcryptjs": "2.4.3",
    "body-parser": "1.20.3",
    "chalk": "4.1.2",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "detect-port": "^1.5.1",
    "dotenv": "16.0.0",
    "express": "4.20.0",
    "express-jwt": "6.1.2",
    "express-paginate": "1.0.2",
    "express-session": "1.18.0",
    "express-validator": "6.15.0",
    "fuse.js": "6.5.3",
    "graphql": "16.8.1",
    "graphql-http": "^1.22.0",
    "graphql-playground-middleware-express": "^1.7.23",
    "jwks-rsa": "2.0.5",
    "lodash": "4.17.21",
    "morgan": "1.10.0",
    "passport": "0.5.0",
    "passport-local": "1.0.0",
    "shortid": "2.2.16",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.2",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "2.8.12",
    "@types/detect-port": "^1.3.2",
    "@types/express": "4.17.21",
    "@types/express-jwt": "0.0.42",
    "@types/express-paginate": "1.0.4",
    "@types/express-serve-static-core": "4.19.6",
    "@types/express-session": "1.18.0",
    "@types/jsonwebtoken": "8.5.8",
    "@types/lodash": "4.14.181",
    "@types/morgan": "1.9.3",
    "@types/node": "^22.10.0",
    "@types/passport": "1.0.16",
    "@types/shortid": "0.0.29",
    "@types/uuid": "8.3.4",
    "@types/validator": "13.7.2",
    "dotenv-cli": "^11.1.0",
    "nodemon": "2.0.22",
    "prisma": "6",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  }
}
