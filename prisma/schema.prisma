generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivacyLevel {
  public
  private
  contacts
}

enum TransactionStatus {
  pending
  incomplete
  complete
}

enum BankTransferType {
  withdrawal
  deposit
}

model User {
  id                  String       @id
  uuid                String       @unique
  firstName           String
  lastName            String
  username            String       @unique
  password            String
  email               String
  phoneNumber         String
  avatar              String
  defaultPrivacyLevel PrivacyLevel
  balance             Int
  createdAt           DateTime
  modifiedAt          DateTime

  @@map("users")
}

model Contact {
  id            String   @id
  uuid          String   @unique
  userId        String
  contactUserId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("contacts")
}

model BankAccount {
  id            String   @id
  uuid          String   @unique
  userId        String
  bankName      String
  accountNumber String
  routingNumber String
  isDeleted     Boolean
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("bank_accounts")
}

model Transaction {
  id                  String            @id
  uuid                String            @unique
  source              String
  amount              Int
  description         String
  privacyLevel        PrivacyLevel
  receiverId          String
  senderId            String
  balanceAtCompletion Int?
  status              TransactionStatus
  requestStatus       String
  requestResolvedAt   String
  createdAt           DateTime
  modifiedAt          DateTime

  @@index([senderId])
  @@index([receiverId])
  @@map("transactions")
}

model Like {
  id            String   @id
  uuid          String   @unique
  userId        String
  transactionId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([transactionId])
  @@map("likes")
}

model Comment {
  id            String   @id
  uuid          String   @unique
  content       String
  userId        String
  transactionId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([transactionId])
  @@map("comments")
}

// payment / like / comment notifications share one table
model Notification {
  id            String   @id
  uuid          String   @unique
  userId        String
  transactionId String
  isRead        Boolean
  status        String? // payment notifications
  likeId        String? // like notifications
  commentId     String? // comment notifications
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("notifications")
}

model BankTransfer {
  id            String           @id
  uuid          String           @unique
  userId        String
  source        String
  amount        Int
  type          BankTransferType
  transactionId String
  createdAt     DateTime
  modifiedAt    DateTime

  @@index([userId])
  @@map("bank_transfers")
}
