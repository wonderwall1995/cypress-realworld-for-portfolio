  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:auth0": "cross-env VITE_AUTH0=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:okta": "cross-env VITE_OKTA=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:cognito": "cross-env VITE_AWS_COGNITO=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:google": "cross-env VITE_GOOGLE=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "predev:cognito": "pnpm build:aws-exports-es5",
    "predev:cognito:ci": "pnpm copy:mock:awsexports && pnpm copy:mock:awsexportses5",
    "copy:mock:awsexports": "ncp scripts/mock-aws-exports.js src/aws-exports.js",
    "copy:mock:awsexportses5": "ncp scripts/mock-aws-exports-es5.js aws-exports-es5.js",
    "build:aws-exports-es5": "cross-env tsc --skipLibCheck --allowJs --lib 'es5' --module 'commonjs' --target 'es5' --moduleResolution 'node' --outDir . src/aws-exports.js; mv aws-exports.js aws-exports-es5.js",
    "start": "cross-env NODE_ENV=development concurrently pnpm:start:react pnpm:start:api",
    "start:ci": "cross-env NODE_ENV=test concurrently pnpm:start:react:proxy-server pnpm:start:api",
    "prestart:ci": "pnpm predev:cognito:ci",
    "start:react": "vite",
    "start:empty": "cross-env NODE_ENV=development EMPTY_SEED=true concurrently pnpm:start:react pnpm:start:api:watch",
    "lint": "eslint && prettier --check \"**/**.{ts,js,tsx}\" \"*.{json,md,yml}\"",
    "list:dev:users": "cat data/database.json | json -a users | json -a id username",
    "types": "tsc --noEmit",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run",
    "start:api": "pnpm tsnode --files backend/app.ts",
    "start:api:watch": "nodemon --exec pnpm tsnode --watch 'backend' backend/app.ts",
    "start:react:proxy-server": "pnpm tsnode scripts/testServer.ts",
    "prettier": "prettier --write \"**/**.{ts,js,tsx}\" \"*.{json,md,yml}\"",
    "tsnode": "ts-node -P tsconfig.tsnode.json",
    "tsnode:not-instrumented": "ts-node -P tsconfig.tsnode.json",
    "db:seed": "pnpm tsnode scripts/generateSeedData",
    "predb:seed:dev": "pnpm predev:cognito:ci",
    "db:seed:dev": "ncp ./data/database-seed.json ./data/database.json",
    "db:seed:empty": "ncp ./data/empty-seed.json ./data/database.json",
    "postdb:seed": "pnpm db:seed:dev",
    "prestart": "pnpm db:seed:dev",
    "predev": "pnpm db:seed:dev",
    "prestart:empty": "pnpm db:seed:empty",
    "prebuild": "pnpm types",
    "prebuild:ci": "pnpm predev:cognito:ci",
    "build:ci": "vite build",
    "build": "vite build",
    "codesandbox:start:api": "pnpm tsnode:not-instrumented --files backend/app.ts",
    "codesandbox:start": "NODE_ENV=development TSC_COMPILE_ON_ERROR=true concurrently \"vite\" pnpm:start:api:codesandbox",
    "postinstall": "husky install && patch-package",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
