{
  "name": "cypress-realworld-app",
  "version": "1.0.0",
  "description": "A payment application used as a portfolio project for end-to-end testing with Playwright. Forked from the Cypress Real World App (MIT License).",
  "repository": {
    "type": "git",
    "url": "https://github.com/wonderwall1995/cypress-realworld-for-portfolio.git"
  },
  "author": "Cypress-io (original); wonderwall1995 (fork)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wonderwall1995/cypress-realworld-for-portfolio/issues"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10"
  },
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:auth0": "cross-env VITE_AUTH0=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:okta": "cross-env VITE_OKTA=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:cognito": "cross-env VITE_AWS_COGNITO=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "dev:google": "cross-env VITE_GOOGLE=true NODE_ENV=development concurrently pnpm:start:react pnpm:start:api:watch",
    "predev:cognito": "pnpm build:aws-exports-es5",
    "predev:cognito:ci": "pnpm copy:mock:awsexports && pnpm copy:mock:awsexportses5",
    "copy:mock:awsexports": "pnpm --filter @rwa/web copy:mock:awsexports",
    "copy:mock:awsexportses5": "pnpm --filter @rwa/web copy:mock:awsexportses5",
    "build:aws-exports-es5": "pnpm --filter @rwa/web build:aws-exports-es5",
    "start": "cross-env NODE_ENV=development concurrently pnpm:start:react pnpm:start:api",
    "start:ci": "cross-env NODE_ENV=test concurrently pnpm:start:react:proxy-server pnpm:start:api",
    "prestart:ci": "pnpm predev:cognito:ci",
    "start:react": "pnpm --filter @rwa/web start",
    "start:react:proxy-server": "pnpm --filter @rwa/web serve:build",
    "start:api": "pnpm --filter @rwa/api start",
    "start:api:watch": "pnpm --filter @rwa/api start:watch",
    "build": "pnpm --filter @rwa/web build",
    "prebuild": "pnpm types",
    "build:ci": "pnpm --filter @rwa/web build:ci",
    "prebuild:ci": "pnpm predev:cognito:ci",
    "lint": "eslint && prettier --check \"**/**.{ts,js,tsx}\" \"*.{json,md,yml}\"",
    "prettier": "prettier --write \"**/**.{ts,js,tsx}\" \"*.{json,md,yml}\"",
    "types": "tsc --noEmit && pnpm -r --if-present types",
    "test:unit": "pnpm -r --if-present test",
    "test:unit:ci": "pnpm -r --if-present test:ci",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps",
    "testid:list": "pnpm --filter @rwa/web testid:list",
    "testid:check": "pnpm --filter @rwa/web testid:check",
    "testid:add": "pnpm --filter @rwa/web testid:add",
    "testid:add:write": "pnpm --filter @rwa/web testid:add:write",
    "prisma:migrate": "pnpm --filter @rwa/api prisma:migrate",
    "prisma:generate": "pnpm --filter @rwa/api prisma:generate",
    "docker:dev": "cross-env NODE_ENV=development concurrently \"pnpm --filter @rwa/web start:host\" \"pnpm --filter @rwa/api start:watch:poll\"",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:reboot": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps",
    "codesandbox:start:api": "pnpm --filter @rwa/api start",
    "codesandbox:start": "NODE_ENV=development TSC_COMPILE_ON_ERROR=true concurrently pnpm:start:react pnpm:codesandbox:start:api",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "dotenv": "16.0.0",
    "eslint": "^10.0.2",
    "globals": "^16.0.0",
    "husky": "7.0.4",
    "npm": "^9.8.0",
    "prettier": "^3.0.0",
    "start-server-and-test": "1.14.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.56.1",
    "wait-on": "^8.0.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
